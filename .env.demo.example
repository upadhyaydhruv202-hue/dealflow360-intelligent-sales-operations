# Demo / judged-hackathon environment. Copy to .env for a safe local demo.
# Catalog: docs/environment.md
#
# Demo mode mocks email, SMS, and OTP, and falls back to mock AI when GEMINI_API_KEY is empty.
# Do not use this file as a production template. Never set ALLOW_DEMO_IN_PRODUCTION on a real tenant.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=Hackathon Starter Kit
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

VITE_API_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
SEED_ON_START=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hackathon
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SAMESITE=lax
TRUST_PROXY=false
STORAGE_SIGNING_SECRET=local-dev-storage-signing-secret-change-me

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DEMO_MODE=true
# ALLOW_DEMO_IN_PRODUCTION=false

AI_ENABLED=true
AI_PROVIDER=mock
GEMINI_API_KEY=

EMAIL_ENABLED=false
EMAIL_PROVIDER=mock

SMS_ENABLED=false
SMS_PROVIDER=mock

ODOO_ENABLED=false
FEATURE_ODOO=false

STORAGE_PROVIDER=local
FEATURE_S3=false

FEATURE_AI=true
FEATURE_AUTOMATION=true
FEATURE_NOTIFICATIONS=true
FEATURE_OTP=true
FEATURE_SMS=false
FEATURE_RAG=false
FEATURE_SEARCH=false
FEATURE_ANALYTICS=false
FEATURE_COPILOT=true
FEATURE_INTENTS=true
FEATURE_PROBLEM_INTELLIGENCE=true
FEATURE_CAPABILITY_RECOMMENDATIONS=true
FEATURE_PROJECT_PLANNING=true
FEATURE_PROJECT_GENERATOR=true
FEATURE_ANOMALY_DETECTION=false
FEATURE_REALTIME=false
FEATURE_PDF=true
OTP_PROVIDER=mock
