# Authoritative catalog: docs/environment.md
# Copy this file to .env for local development. Never commit .env.
#
# PUBLIC FRONTEND CONFIG — the only variable Vite may bake into the browser bundle.
# Do not add VITE_ prefixes to secrets. The SPA must not receive API keys or JWTs.
#
# SERVER-ONLY SECRETS — everything below VITE_API_URL stays on the API, worker,
# Prisma, Compose, and CI. Production refuses to start if required secrets are missing.

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_NAME=DealFlow360
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
REQUEST_BODY_LIMIT=1mb

# Public frontend (optional; leave empty to use the Vite / nginx proxy)
VITE_API_URL=

# Vite dev-server only. Not loaded by backend/src/config. Docker frontend-dev sets http://backend:5000.
# API_PROXY_TARGET=http://localhost:5000

# ==========================================
# DOCKER (local Compose interpolation only)
# ==========================================

# Host-based `npm run dev` uses DATABASE_URL / REDIS_URL with localhost below.
# `docker compose up` overrides those URLs inside containers to service names
# (postgres, redis). Do not put production passwords here.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hackathon
SEED_ON_START=true

# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hackathon
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://localhost:6379

# ==========================================
# JOBS
# ==========================================

JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_MS=200
JOB_TIMEOUT_MS=60000
# Compose sets this per service. Unset for local `npm run dev` so the API consumes jobs.
# JOBS_PROCESS=true

# Defaults to FEATURE_AUTOMATION. Set false to keep rules without clock ticks.
# SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL=1m
SCHEDULER_POLL=1s

# ==========================================
# AUTHENTICATION
# ==========================================

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=local-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-32

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=hackathon-starter-kit
JWT_AUDIENCE=hackathon-starter-kit-api

AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=72
AUTH_PASSWORD_REQUIRE_UPPERCASE=false
AUTH_PASSWORD_REQUIRE_LOWERCASE=false
AUTH_PASSWORD_REQUIRE_NUMBER=false
AUTH_PASSWORD_REQUIRE_SPECIAL=false
AUTH_BCRYPT_COST=12
AUTH_DEFAULT_ROLE=user
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_IP_RATE_LIMIT_MAX=20
AUTH_LOGIN_RATE_LIMIT_WINDOW=15m
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SAMESITE=lax

OTP_PROVIDER=auto
OTP_DIGITS=6
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s
OTP_RATE_LIMIT_MAX=5
OTP_IP_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW=15m
# Dedicated HMAC secret for stored OTP hashes. Required in production when FEATURE_OTP=true.
# OTP_HASH_SECRET=

# ==========================================
# ODOO
# ==========================================

ODOO_ENABLED=false
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_TIMEOUT_MS=15000
ODOO_MAX_RETRIES=2
ODOO_RETRY_BASE_MS=200

# ==========================================
# AI
# ==========================================

AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=

AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=200

# Optional RAG (see docs/rag.md). Leave FEATURE_RAG=false unless the problem needs semantic search.
# Unset RAG_VECTOR_STORE uses postgres when DATABASE_URL is set (API and workers share the index), otherwise memory.
# RAG_VECTOR_STORE=memory
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.28
# RAG_MAX_CONTEXT_CHARS=12000
# RAG_MAX_DOCUMENT_CHARS=100000
# RAG_MAX_CHUNKS_PER_DOCUMENT=200
# RAG_ASYNC_THRESHOLD_CHARS=20000

# Optional search (see docs/search.md). Leave FEATURE_SEARCH=false unless the problem needs keyword/full-text lookup.
# Unset SEARCH_PROVIDER uses postgres when DATABASE_URL is set, otherwise memory. Elasticsearch is not implemented.
# SEARCH_PROVIDER=postgres
# SEARCH_FUZZY_THRESHOLD=0.3

# Optional analytics (see docs/analytics.md). Leave FEATURE_ANALYTICS=false unless the problem needs KPIs / time-series.
# Unset ANALYTICS_PROVIDER uses postgres when DATABASE_URL is set, otherwise memory. Warehouses are not implemented.
# ANALYTICS_PROVIDER=postgres
# ANALYTICS_MAX_RANGE_DAYS=90
# ANALYTICS_MAX_SERIES_POINTS=366
# ANALYTICS_MAX_EXPORT_ROWS=1000

# Optional anomaly engine (see docs/anomaly.md). Leave FEATURE_ANOMALY_DETECTION=false unless the problem needs it.
# ANOMALY_ZSCORE_MIN_SAMPLES=8
# ANOMALY_ZSCORE_THRESHOLD=2
# ANOMALY_ZSCORE_HIGH=3
# ANOMALY_PERCENT_CHANGE_LOW=10
# ANOMALY_PERCENT_CHANGE_MEDIUM=15
# ANOMALY_PERCENT_CHANGE_HIGH=20
# ANOMALY_MOVING_AVERAGE_WINDOW=5
# ANOMALY_MOVING_AVERAGE_DEVIATION_PCT=15
# ANOMALY_TREND_WINDOW=5
# ANOMALY_MAX_POINTS=500
# ANOMALY_EXPLAIN=true

# Optional Server-Sent Events (see docs/realtime.md). Leave FEATURE_REALTIME=false unless the problem needs live status.
# REALTIME_HEARTBEAT=15s
# REALTIME_MAX_CONNECTIONS=200
# REALTIME_MAX_CONNECTIONS_PER_USER=5

# ==========================================
# EMAIL
# ==========================================

EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_TIMEOUT_MS=10000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

RESEND_API_KEY=
BREVO_API_KEY=

# ==========================================
# SMS
# ==========================================

SMS_ENABLED=false
SMS_PROVIDER=mock

SMS_API_KEY=
SMS_FROM=
SMS_HTTP_URL=
SMS_TIMEOUT_MS=10000

# ==========================================
# STORAGE
# ==========================================

# local (default): disk + PostgreSQL dual-write when DATABASE_URL is set
# postgres: stored_objects only (shared across hosts that share the DB)
# s3: AWS S3 (private bucket; not required for local development)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage
STORAGE_MAX_BYTES=10485760
STORAGE_SIGNED_URL_EXPIRES=300
# Dedicated HMAC secret for local/postgres signed downloads. Never reuse JWT_ACCESS_SECRET.
STORAGE_SIGNING_SECRET=local-dev-storage-signing-secret-change-me

DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_TEXT_CHARS=100000
DOCUMENT_CONFIDENCE_THRESHOLD=0.7
DOCUMENT_ASYNC_THRESHOLD_BYTES=1048576

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==========================================
# SECURITY
# ==========================================

RATE_LIMIT_ENABLED=true
# Default false. Set 1 only behind a proxy that overwrites X-Forwarded-For (nginx profile).
TRUST_PROXY=false
RATE_LIMIT_FAIL_CLOSED=
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW=1m
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_UPLOAD_WINDOW=15m
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW=1m
RATE_LIMIT_AUTHENTICATED_MAX=120
RATE_LIMIT_AUTHENTICATED_WINDOW=1m
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_ADMIN_WINDOW=1m
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX=5
AUTH_PASSWORD_RESET_IP_RATE_LIMIT_MAX=20
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW=15m

# ==========================================
# CORS
# ==========================================

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ==========================================
# DEMO MODE
# ==========================================

DEMO_MODE=true
# Production refuses DEMO_MODE unless this is also true. Never set it on a real tenant.
# ALLOW_DEMO_IN_PRODUCTION=false

# ==========================================
# FEATURE FLAGS
# ==========================================

# Missing flags default to false except FEATURE_PDF (true). This file turns common local-demo flags on.
FEATURE_AI=true
FEATURE_ODOO=false
FEATURE_AUTOMATION=true
FEATURE_NOTIFICATIONS=true
FEATURE_OTP=true
FEATURE_SMS=false
FEATURE_S3=false
FEATURE_RAG=false
FEATURE_SEARCH=false
FEATURE_ANALYTICS=false
FEATURE_COPILOT=true
FEATURE_INTENTS=true
FEATURE_PROBLEM_INTELLIGENCE=true
FEATURE_CAPABILITY_RECOMMENDATIONS=true
FEATURE_PROJECT_PLANNING=true
FEATURE_PROJECT_GENERATOR=true
FEATURE_ANOMALY_DETECTION=false
FEATURE_REALTIME=false
FEATURE_PDF=true
