# Test process environment. Copy to .env.test (gitignored).
# backend/tests/setup-env.ts loads .env.test when present.
# Catalog: docs/environment.md
#
# Do not put production secrets here. CI sets DATABASE_URL and REDIS_URL on the runner.

NODE_ENV=test
PORT=5000
HOST=127.0.0.1
APP_NAME=Hackathon Starter Kit
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=silent
DEMO_MODE=true
AI_ENABLED=false
FEATURE_AI=false
AI_PROVIDER=mock

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hackathon_test
DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT_SECONDS=10

JWT_ACCESS_SECRET=test-access-secret-not-for-production-32
JWT_REFRESH_SECRET=test-refresh-secret-not-for-production-32
JWT_ISSUER=test-issuer
JWT_AUDIENCE=test-audience
AUTH_BCRYPT_COST=4
AUTH_DEFAULT_ROLE=user
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SAMESITE=lax

RATE_LIMIT_ENABLED=true
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173

# Optional. Enables Redis KV and BullMQ integration tests when Redis is running.
# REDIS_URL=redis://localhost:6379
STORAGE_SIGNING_SECRET=test-storage-signing-secret-not-for-production
