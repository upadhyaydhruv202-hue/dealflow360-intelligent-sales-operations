{
  "name": "@hackathon/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "db:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "db:migrate": "tsx scripts/prisma-with-env.ts migrate deploy",
    "db:migrate:dev": "tsx scripts/prisma-with-env.ts migrate dev",
    "db:seed": "tsx scripts/prisma-with-env.ts db seed",
    "db:reset": "tsx scripts/prisma-with-env.ts migrate reset --force",
    "db:test:prepare": "tsx scripts/prepare-test-database.ts",
    "postinstall": "prisma generate --schema ../database/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "../database/prisma/schema.prisma",
    "seed": "tsx ../database/prisma/seed.ts"
  },
  "dependencies": {
    "@hackathon/api-contract": "0.1.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.6",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "prisma": "^6.16.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
