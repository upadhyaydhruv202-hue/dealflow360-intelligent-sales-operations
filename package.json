{
  "name": "hackathon-starter-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable full-stack starter kit for hackathons, MVPs, and rapid prototypes.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^24",
    "npm": "^11"
  },
  "workspaces": [
    "packages/api-contract",
    "backend",
    "frontend",
    "workers",
    "modules/problem"
  ],
  "scripts": {
    "prepare": "npm run build -w @hackathon/api-contract",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:all": "concurrently -n backend,frontend,workers -c blue,green,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\" \"npm run dev -w workers\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:workers": "npm run dev -w workers",
    "build": "npm run build -w @hackathon/api-contract && npm run build -w @hackathon/problem && npm run build --workspaces --if-present",
    "start": "npm run start -w backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present --",
    "test:integration": "npm run test:integration --workspaces --if-present --",
    "test:watch": "npm run test:watch -w backend",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w backend --",
    "security:secrets": "npm run security:secrets -w backend",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "deps:up": "docker compose up -d postgres redis",
    "deps:down": "docker compose stop postgres redis",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:smoke": "node infra/scripts/smoke.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:migrate:dev": "npm run db:migrate:dev -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:reset": "npm run db:reset -w backend",
    "db:test:prepare": "npm run db:test:prepare -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.69.0"
  }
}
